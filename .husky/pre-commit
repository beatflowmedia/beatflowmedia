# ---------------------------------------------------------------- secrets
#
# This runs FIRST, and before the JS/TS early-exit below, because the file that
# leaked a live Stripe key was a .toml and a .md -- neither of which the UI/UX
# check ever looks at.
#
# A live sk_live_ key sat in src/netlify.toml on a PUBLIC GitHub repo from
# 2026-04-13 until it was found on 2026-09-19. Rotation was the fix; this is the
# guard that stops the next one.
#
# It matches 20+ characters of key material, so documentation placeholders
# (sk_live_YOUR), bare prefixes used as detection patterns in
# agents/SecurityAuditAgent.js, and the scrubbed _REPLACED_ markers all pass.
echo "🔑 Scanning staged changes for secrets..."

SECRETS=$(git diff --cached -U0 -- . |
  grep -E '^\+' |
  grep -vE '^\+\+\+' |
  grep -oE '(sk_live_|sk_test_|rk_live_)[A-Za-z0-9]{20,}|-----BEGIN (RSA |EC )?PRIVATE KEY-----' |
  sort -u || true)

if [ -n "$SECRETS" ]; then
  echo "❌ REFUSING: staged changes contain what looks like a real secret."
  echo ""
  echo "$SECRETS" | cut -c1-14 | sed 's/^/   /' | sed 's/$/…/'
  echo ""
  echo "   Remove it and use an environment variable. If the key was ever"
  echo "   committed or pushed, ROTATE it -- deleting the file does not remove"
  echo "   it from git history."
  exit 1
fi

echo "✅ No secrets in staged changes"

echo "🎨 Running UI/UX pre-commit checks..."

# Get staged files
#
# `|| true` is load-bearing. husky runs this via `sh -e` (see .husky/_/h), so
# the assignment takes grep's exit status, and grep exits 1 when nothing
# matched. Without it the script died on this line for any commit that touched
# no JS/TS file - rules, config, JSON, markdown - and the `-z` guard below,
# which exists for exactly that case, was unreachable. That is what made
# `--no-verify` look like the normal way to commit in this repo.
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(js|jsx|ts|tsx)$' || true)

if [ -z "$STAGED_FILES" ]; then
  echo "✅ No JavaScript/TypeScript files to check"
  exit 0
fi

# Run the UI/UX check on the STAGED files only.
#
# This block used to write the staged file list to a temp file and then never pass it
# to the CLI, which fell back to scanning `src`. Two bugs stacked on top of that:
#
#   1. gatherFiles() built its glob pattern with path.join(), which emits BACKSLASHES
#      on Windows, and glob v9+ reads a backslash as an escape character. The pattern
#      matched nothing, so every run analysed 0 files and scored a perfect 100/100.
#   2. --exit-on-critical was never passed, and it defaults to false -- so even a real
#      critical finding would have exited 0 and the check below could never fire.
#
# Net effect: three screens of green on every commit, reading not one line of code.
# With the glob fixed, a full `src` scan reports 2287 issues, so pointing this at the
# whole tree would block every commit on pre-existing debt -- and a hook that always
# fails gets bypassed within a day, which is how --no-verify becomes normal here.
#
# So it judges exactly what is being committed. New code is held to the line; existing
# debt is a ratchet to work down, recorded in CLAUDE.md, not a wall across every commit.
echo "📁 Checking $(echo "$STAGED_FILES" | wc -l) staged file(s)..."

FILE_LIST=$(echo "$STAGED_FILES" | tr '
' ',' | sed 's/,$//')

# REPORTS, DOES NOT GATE. `--exit-on-critical` is deliberately gone from this line.
#
# The comment above says the intent: "New code is held to the line; existing debt is a
# ratchet to work down, recorded in CLAUDE.md, not a wall across every commit." The
# implementation did not deliver it, because it judged each staged file WHOLE. Moving one
# JSON-LD tag in Playlist.js on 2026-10-23 presented 23 accessibility findings -- none in
# the changed line, none introduced that day, and the brand-new file in the same commit
# had zero. That is the wall the comment warned about, and the hook's own closing line
# says what a wall produces: --no-verify as the normal way to commit.
#
# So the review still runs and still prints its design-token and music-UX findings, which
# are worth seeing. The GATE is verify:a11y below, which holds a recorded per-file
# baseline and fails only on growth -- the same shape as KNOWN_FIXTURES here and
# KNOWN_UNRESOLVED in verify-deps.js.
node agents/cli.js uiux review   --files "$FILE_LIST"   --profile pre-commit

echo "✅ UI/UX report complete (findings above are a report, not a gate)"

# ---------------------------------------------------------------- accessibility
#
# THIS is the accessibility gate. 124 files carry 464 pre-existing CRITICAL/HIGH
# findings; the baseline is in scripts/a11y-baseline.json and the only correct direction
# is down. A file not in the baseline fails on ANY issue, so new code is held to the line.
#
# If a finding is wrong, fix the DETECTOR, not the baseline -- three rules in
# AccessibilityChecker.js have matched prose rather than markup, including one that read
# the word "volume" in a comment on a page with no audio.
echo "♿ Checking accessibility against the recorded baseline..."
node scripts/verify-a11y-staged.js
A11Y_EXIT_CODE=$?

if [ $A11Y_EXIT_CODE -ne 0 ]; then
  echo "❌ A file gained an accessibility issue"
  echo "💡 Fix it, or fix the detector and prove it both ways. Do NOT reach for"
  echo "   --no-verify: a failing hook is a finding."
  exit 1
fi

# ---------------------------------------------------------------- fixture data
#
# Runs LAST because it is the cheapest check and the one with the widest blast radius:
# a fabricated number that reaches a screen is read as a measurement, and four of them
# shipped between 2026-10-20 and 2026-10-21 -- including a live blog post naming an
# artist and an income she never earned.
#
# It is a RATCHET. Sixteen rendering files already carry a fixture marker and the check
# passes on all of them; only a NEW one in live code fails. A hook that fails on
# pre-existing debt is a hook that teaches people to use --no-verify.
echo "🧪 Checking for fixture data in rendering code..."
node scripts/verify-no-fixtures.js
FIXTURE_EXIT_CODE=$?

if [ $FIXTURE_EXIT_CODE -ne 0 ]; then
  echo "❌ A rendering file gained fixture data"
  echo "💡 Wire it to real data, or do not render it. If it is genuinely not a fixture,"
  echo "   add it to KNOWN_FIXTURES in scripts/verify-no-fixtures.js WITH A REASON."
  exit 1
fi

exit 0
