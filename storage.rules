rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // The same allowlist firestore.rules uses, named once instead of inlined.
    // It was spelled out below and nowhere else, so every other rule in this
    // file fell back to "any authenticated user" for want of a way to say this.
    function isPlatformAdmin() {
      return request.auth != null &&
             (request.auth.token.email == 'perriceconsulting@gmail.com' ||
              request.auth.token.email == 'percyricemusic@gmail.com');
    }

    // Admin access - allow platform admins to list and manage all storage
    match /{allPaths=**} {
      allow list: if isPlatformAdmin();
    }

    // Admin content uploads - for content ingestion dashboard
    match /admin-uploads/{allPaths=**} {
      // Was `request.auth != null`, commented "Temporarily allow any
      // authenticated user". The path is named admin-uploads; it should mean it.
      allow read, write: if isPlatformAdmin();
    }

    // Allow authenticated users to upload application resumes
    match /applications/{allPaths=**} {
      // Any signed-in user can upload and read their uploaded resumes
      allow create, read: if request.auth.uid != null;
      // Only admins can delete any uploads
      allow delete: if request.auth.token.admin == true;
    }

    // Artist uploads - covers are publicly readable, audio requires auth
    match /artist-uploads/covers/{allPaths=**} {
      allow read: if true; // Album/song covers are public
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024; // 10MB limit for covers
    }

    match /artist-uploads/audio/{allPaths=**} {
      // Secure audio streaming: Requires authentication
      // Signed URLs are generated via Cloud Function (getSignedAudioUrl)
      // This provides security, analytics, and monetization capabilities
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 500 * 1024 * 1024; // 500MB limit for high-quality WAV files
    }

    match /artist-uploads/{allPaths=**} {
      // Catch-all for other artist uploads
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 500 * 1024 * 1024;
    }

    // Artist profile and banner images
    match /artists/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024; // 5MB limit for profile/banner images
    }

    // User profile pictures and avatars
    match /user-content/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024; // 5MB limit for profiles
    }

    // User playlist covers
    match /users/{userId}/playlist-covers/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024; // 5MB limit for playlist covers
    }

    // Audio files for streaming
    match /audio/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 100 * 1024 * 1024; // 100MB limit for audio
    }

    // Temporary uploads during processing
    match /temp-uploads/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 200 * 1024 * 1024; // 200MB limit for temp files
    }

    // Appeal evidence uploads - artists can upload evidence for their appeals
    match /appeal-evidence/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024; // 10MB limit for appeal evidence
    }

    // Curator application uploads - portfolio images, screenshots, etc.
    match /curator-applications/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024; // 10MB limit for application materials
    }

    /* Songs - published track covers and audio.
       The comment already said "admin-managed via Content Management" while the
       rule allowed any authenticated write. This is the object store behind the
       PUBLISHED catalogue: a write here replaces what a paying customer
       downloads. Reads are unchanged — covers public, audio authenticated. */
    match /songs/covers/{allPaths=**} {
      allow read: if true; // Song covers are public
      allow write: if isPlatformAdmin()
        && request.resource.size < 10 * 1024 * 1024; // 10MB limit for covers
    }

    match /songs/audio/{allPaths=**} {
      allow read: if request.auth != null; // Authenticated users can stream
      allow write: if isPlatformAdmin()
        && request.resource.size < 500 * 1024 * 1024; // 500MB limit for high-quality audio
    }

    // Deny all other storage access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}