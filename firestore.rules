rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is platform admin
    function isPlatformAdmin() {
      return request.auth != null &&
             (request.auth.token.email == 'perriceconsulting@gmail.com' ||
              request.auth.token.email == 'percyricemusic@gmail.com');
    }

    // Allow anyone to read approved songs (both individual docs and queries)
    match /songs/{songId} {
      allow read: if true;
      allow list: if true; // Allow collection queries
      allow create: if request.auth != null;
      allow update: if request.auth != null &&
                      (request.auth.uid == resource.data.uploadedBy ||
                       isPlatformAdmin());
      allow delete: if request.auth != null &&
                      (request.auth.uid == resource.data.uploadedBy ||
                       isPlatformAdmin());
    }

    // Allow anyone to read track documents for playlist search
    match /tracks/{trackId} {
      allow read: if true;
    }

    // Supervisor sampler docs (public)
    match /supervisorSamplers/{id} {
      allow read: if true;
    }

    // Authenticated user data
    match /users/{userId} {
      allow read, write: if request.auth.uid == userId;

      // User playlists
      match /playlists/{playlistId} {
        allow read, write: if request.auth.uid == userId;
      }
      // User library
      match /library/{libraryDoc} {
        allow read, write: if request.auth.uid == userId;
      }
      // Playback resume positions per user
      match /songPositions/{songId} {
        allow read, write: if request.auth.uid == userId;
      }
    }

    // Submissions: artist can read their own, curators (admin) can read all
    match /submissions/{submissionId} {
      allow create: if request.auth.uid != null;
      allow read: if request.auth.uid == resource.data.artistId || request.auth.token.admin == true;
      allow update: if request.auth.token.admin == true;
    }

    // Artist submissions (for ForArtists.js upload form)
    match /artistSubmissions/{submissionId} {
      allow create: if request.auth.uid != null;
      allow read: if request.auth.uid == resource.data.uploadedBy || isPlatformAdmin();
      allow update: if isPlatformAdmin();
    }

    // Artist profiles and content
    match /artists/{artistId} {
      allow read: if true;
      allow write: if request.auth.uid == artistId || request.auth.token.admin == true;
    }

    // Tour dates - artists can manage their own, anyone can read
    match /tours/{tourId} {
      allow read: if true;
      allow create: if request.auth.uid != null;
      allow update, delete: if request.auth.uid == resource.data.artistId || isPlatformAdmin();
    }

    // Albums collection
    match /albums/{albumId} {
      allow read: if true;
      allow list: if true; // Allow collection queries
      allow create: if request.auth.uid != null;
      allow update: if request.auth.uid == resource.data.artistId ||
                        request.auth.uid == resource.data.uploadedBy ||
                        request.auth.token.admin == true ||
                        // Allow authenticated users to update rating/review fields
                        (request.auth.uid != null &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['averageRating', 'reviewCount']));
      allow delete: if request.auth != null &&
                      (request.auth.uid == resource.data.uploadedBy ||
                       request.auth.uid == resource.data.artistId ||
                       isPlatformAdmin());
    }

    // Album Reviews - authenticated users can create and read
    match /albumReviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth.uid != null;
      allow update, delete: if request.auth.uid == resource.data.userId || request.auth.token.admin == true;
    }

    // Playlists (public read, authenticated write)
    match /playlists/{playlistId} {
      allow read: if true;
      allow create: if request.auth.uid != null;
      allow update: if request.auth.uid == resource.data.creatorId || request.auth.token.admin == true;
    }

    // Playlist tracks (public read, owners/collaborators can write)
    match /playlistTracks/{trackId} {
      allow read: if true;
      allow create: if request.auth.uid != null;
      allow update, delete: if request.auth.uid != null;
    }

    // Campaigns for artists
    match /campaigns/{campaignId} {
      allow read: if request.auth.uid == resource.data.artistId || request.auth.token.admin == true;
      allow create: if request.auth.uid != null;
      allow update: if request.auth.uid == resource.data.artistId || request.auth.token.admin == true;
    }

    // User queue (player queue management)
    match /userQueues/{userId} {
      allow read, write: if request.auth.uid == userId;
    }

    // User queues (alternative collection name)
    match /queues/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null;
    }

    // Analytics events - only platform admins can read
    match /analytics/{eventId} {
      allow create: if request.auth.uid != null;
      allow read: if isPlatformAdmin();
    }

    // Supervisors collection (contacts)
    match /supervisors/{id} {
      allow read: if true;
      allow write: if request.auth.token.admin == true;
    }

    // Allow authenticated users to read public collections
    match /genres/{genreId} {
      allow read: if true;
    }

    match /featuredContent/{contentId} {
      allow read: if true;
    }

    // Playback events (for player analytics)
    match /playbackEvents/{eventId} {
      allow create: if request.auth.uid != null;
      allow read: if request.auth.token.admin == true;
    }

    // ========================================
    // BEATFLOW AGENTS COLLECTIONS
    // ========================================

    // Analytics events - write for agents, read for admins
    match /analytics_events/{eventId} {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow write: if request.auth != null;
    }

    // Content metadata - read for all, write for authenticated
    match /content_metadata/{contentId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Recommendations - read only for owner or admin
    match /recommendations/{recommendationId} {
      allow read: if request.auth != null &&
                     (resource.data.userId == request.auth.uid ||
                      request.auth.token.admin == true);
      allow write: if request.auth != null;
    }

    // Recommendation interactions tracking
    match /recommendation_interactions/{interactionId} {
      allow read: if request.auth != null &&
                     (resource.data.userId == request.auth.uid ||
                      request.auth.token.admin == true);
      allow write: if request.auth != null;
    }

    // Moderation results - admin only
    match /moderation_results/{contentId} {
      allow read, write: if request.auth != null &&
                            request.auth.token.admin == true;
    }

    // Notifications - admin write, user read their own
    match /notifications/{notificationId} {
      allow read: if request.auth != null &&
                     (resource.data.recipients == request.auth.uid ||
                      request.auth.token.admin == true);
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // User preferences for notifications
    match /user_preferences/{userId} {
      allow read, write: if request.auth != null &&
                            (request.auth.uid == userId ||
                             request.auth.token.admin == true);
    }

    // Listening history
    match /listening_history/{historyId} {
      allow read: if request.auth != null &&
                     (resource.data.userId == request.auth.uid ||
                      request.auth.token.admin == true);
      allow write: if request.auth != null;
    }

    // User notifications subcollection
    match /users/{userId}/notifications/{notificationId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Advertisements - allow anyone to read, authenticated users to write
    match /advertisements/{adId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Song likes - track which users liked which songs
    match /songLikes/{songId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // User likes - track individual like records
    match /likes/{likeId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Song plays - track play counts
    match /songPlays/{songId} {
      allow read: if true;
      allow write: if true; // Allow anyone to increment play count
    }

    // Podcast episodes - allow anyone to read
    match /podcast_episodes/{episodeId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth.token.admin == true;
    }

    // Audiobooks - allow anyone to read
    match /audiobooks/{audiobookId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth.token.admin == true;
    }

    // Jobs - allow anyone to read open positions
    match /jobs/{jobId} {
      allow read: if true;
      allow create, update, delete: if request.auth.token.admin == true;
    }

    // Job applications - allow authenticated users to submit, platform admins to manage
    match /applications/{applicationId} {
      allow create: if request.auth != null;
      allow read: if request.auth.uid == resource.data.userId || isPlatformAdmin();
      allow update, delete: if isPlatformAdmin();
    }

    // Vendor applications - allow anyone to submit, admin to read/manage
    match /vendorApplications/{applicationId} {
      allow create: if true; // Allow unauthenticated submissions
      allow read, update, delete: if request.auth.token.admin == true;
    }

    // Creative quote requests - allow anyone to submit, admin to read/manage
    match /creativeQuotes/{quoteId} {
      allow create: if true; // Allow unauthenticated submissions
      allow read, update, delete: if request.auth.token.admin == true;
    }

    // Ad signups - allow anyone to submit, admin to read/manage
    match /adSignups/{signupId} {
      allow create: if true; // Allow unauthenticated submissions
      allow read, update, delete: if request.auth.token.admin == true;
    }

    // Advertising inquiries - allow anyone to submit, admin to read/manage
    match /advertisingInquiries/{inquiryId} {
      allow create: if true; // Allow unauthenticated submissions
      allow read, update, delete: if request.auth.token.admin == true;
    }

    // Sync licensing inquiries - allow anyone to submit, admin to read/manage
    match /syncLicensingInquiries/{inquiryId} {
      allow create: if true; // Allow unauthenticated submissions
      allow read, update, delete: if isPlatformAdmin();
    }

    // Investor requests - allow anyone to submit, admin to read/manage
    match /investorRequests/{requestId} {
      allow create: if true; // Allow unauthenticated submissions
      allow read, update, delete: if isPlatformAdmin();
    }

    // ========================================
    // STRIPE PURCHASES & DOWNLOADS
    // ========================================

    // Purchases - users can read their own purchases, admins can read all
    match /purchases/{purchaseId} {
      allow create: if false; // Only created via webhook
      allow read: if request.auth != null &&
                     (resource.data.userId == request.auth.uid || isPlatformAdmin());
      allow update, delete: if isPlatformAdmin();
    }

    // Downloads - users can create their own download records, read their own history
    match /downloads/{downloadId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null &&
                     (resource.data.userId == request.auth.uid || isPlatformAdmin());
      allow update, delete: if isPlatformAdmin();
    }

    // Failed payments - admin only
    match /failed_payments/{paymentId} {
      allow read, write: if isPlatformAdmin();
    }

    // User sessions - for tracking active tokens
    match /user_sessions/{sessionId} {
      allow read, write: if request.auth != null &&
                            (resource.data.userId == request.auth.uid || isPlatformAdmin());
    }

    // User devices - for device management
    match /user_devices/{deviceId} {
      allow read, write: if request.auth != null &&
                            (resource.data.userId == request.auth.uid || isPlatformAdmin());
    }

    // Security alerts - admin only
    match /security_alerts/{alertId} {
      allow read, write: if isPlatformAdmin();
    }

    // Error logs - admin only
    match /error_logs/{logId} {
      allow read: if isPlatformAdmin();
      allow write: if request.auth != null;
    }

    // Custom Genres - artists can create, admins can approve
    match /customGenres/{genreId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow update: if request.auth.uid == resource.data.createdBy || isPlatformAdmin();
      allow delete: if request.auth.uid == resource.data.createdBy || isPlatformAdmin();
    }

    // Custom Categories - artists can create, admins can approve
    match /customCategories/{categoryId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow update: if request.auth.uid == resource.data.createdBy || isPlatformAdmin();
      allow delete: if request.auth.uid == resource.data.createdBy || isPlatformAdmin();
    }

    // Custom Moods - artists can create, admins can approve
    match /customMoods/{moodId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow update: if request.auth.uid == resource.data.createdBy || isPlatformAdmin();
      allow delete: if request.auth.uid == resource.data.createdBy || isPlatformAdmin();
    }

    // Credit Transactions - track submission credit purchases and usage (legacy)
    match /creditTransactions/{transactionId} {
      allow create: if false; // Only created via webhook
      allow read: if request.auth != null &&
                     (resource.data.userId == request.auth.uid || isPlatformAdmin());
    }

    // Artist Memberships - track membership subscriptions
    match /artistMemberships/{membershipId} {
      allow create: if false; // Only created via webhook
      allow read: if request.auth != null &&
                     (resource.data.userId == request.auth.uid || isPlatformAdmin());
      allow update: if isPlatformAdmin();
    }

    // ========================================
    // ENGAGEMENT METRICS FOR ML/AI ANALYSIS
    // ========================================

    // Play Events - individual play tracking for ML
    match /playEvents/{eventId} {
      allow create: if request.auth != null;
      allow read: if isPlatformAdmin();
    }

    // Like Events - individual like/unlike tracking for ML
    match /likeEvents/{eventId} {
      allow create: if request.auth != null;
      allow read: if isPlatformAdmin();
    }

    // Follow Events - individual follow/unfollow tracking for ML
    match /followEvents/{eventId} {
      allow create: if request.auth != null;
      allow read: if isPlatformAdmin();
    }

    // Song Metrics - aggregate engagement data
    match /songMetrics/{songId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Album Metrics - aggregate engagement data
    match /albumMetrics/{albumId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Artist Metrics - aggregate engagement data
    match /artistMetrics/{artistId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // User Metrics - aggregate user activity data
    match /userMetrics/{userId} {
      allow read: if request.auth != null &&
                     (request.auth.uid == userId || isPlatformAdmin());
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ========================================
    // STRIPE CONNECT & PAYOUTS
    // ========================================

    // Artist Balances - artists can read their own balance, admins can read all
    match /artistBalances/{artistId} {
      allow read: if request.auth != null &&
                     (request.auth.uid == artistId || isPlatformAdmin());
      allow write: if false; // Only written by Cloud Functions
    }

    // Revenue Allocations - artists can read their own allocations, admins can read all
    match /revenueAllocations/{allocationId} {
      allow read: if request.auth != null &&
                     (resource.data.artistId == request.auth.uid || isPlatformAdmin());
      allow write: if false; // Only written by Cloud Functions
    }

    // Payout Requests - artists can read their own requests, admins can read all
    match /payoutRequests/{requestId} {
      allow read: if request.auth != null &&
                     (resource.data.artistId == request.auth.uid || isPlatformAdmin());
      allow write: if false; // Only written by Cloud Functions
    }

    // Failed Payouts - admin only
    match /failedPayouts/{payoutId} {
      allow read, write: if isPlatformAdmin();
    }

    // Pending Payouts - artists can read their own pending payouts, admins can manage
    match /pendingPayouts/{payoutId} {
      allow read: if request.auth != null &&
                     (resource.data.artistId == request.auth.uid || isPlatformAdmin());
      allow write: if isPlatformAdmin(); // Only admins can manually process
    }

    // Failed Transfers - admin only
    match /failedTransfers/{transferId} {
      allow read, write: if isPlatformAdmin();
    }

    // Payout Summaries - artists can read their own summaries
    match /payoutSummaries/{userId} {
      allow read: if request.auth != null &&
                     (request.auth.uid == userId || isPlatformAdmin());
      allow write: if false; // Only written by Cloud Functions
    }

    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
