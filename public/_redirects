# Licence QR short links: /r/<ISRC> -> the record's page.
#
# MUST stay above the SPA catch-all. This rule exists in netlify.toml too, and that
# copy alone did nothing: the catch-all below matched first and served index.html, so
# /r/ANYTHING returned 200 with no Location while the function itself was deployed and
# working. Same failure shape as the CSP copies -- a config in two files where one
# silently wins, and the one that wins is missing the entry.
/r/*  /.netlify/functions/redirect-isrc/:splat  200

# Public catalogue feed: what is licensable, at what price, under which licence version.
# BeatFlow Radio fetches this at build time instead of holding a copy that drifts.
/api/catalog.json  /.netlify/functions/catalog-feed  200

# Licence certificate verification. MUST stay above the SPA catch-all, and must be a
# function rather than an app route: the HMAC secret cannot reach a browser, and an
# unknown licence id has to return a real "no such licence" page instead of the shell.
/verify/*  /.netlify/functions/verify-license/:splat  200

