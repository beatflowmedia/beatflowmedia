# Node modules
node_modules/

# Build output
build/
dist/

# Dependency directories
.npm/
.pnp/
.pnp.js
.cache/
.cache-loader/

# Local environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing
coverage/
*.lcov

# IDEs and editors
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS-specific
.DS_Store
Thumbs.db

# Netlify
netlify.toml
.netlify/

# React-specific
*.jsx
*.tsx
*.map
public/static/

# Stripe - prevent sensitive info leakage
stripe.log
stripe-secrets.json
webhooks.log

# Misc
*.tgz
*.zip
*.bak
*.tmp
*.orig
*.log
*.pid

# Optional: lock files (only if not using a lock strategy)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

githubPAT.txt
netlify.toml
*storybook.log
storybook-static

public/advertisements/
nul
netlify/functions/nul

# Firebase Service Account Key (sensitive)
serviceAccountKey.json

# Local HTTPS dev certificates (mkcert). Never commit a private key --
# netlify.toml [dev] points here, and each developer generates their own:
#   mkcert -cert-file .certs/localhost.pem -key-file .certs/localhost-key.pem localhost 127.0.0.1 ::1
.certs/
*.pem

# Build output under any name. `build/` alone missed these: build_devbak is an
# old manual copy, and build.stale-* is what a rename leaves behind. Generated
# output must never become 400 untracked files competing for review attention.
build_devbak/
build.stale-*/
build.*/

# The pre-commit hook writes a timestamped UIUXExpertAgent report on every
# commit. That is generated output: it has no reviewable diff, it conflicts on
# every branch, and two copies were committed before this was noticed.
agents/reports/
